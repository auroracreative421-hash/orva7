rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidWishlistArray(arr) {
      return arr is list
        && arr.size() <= 50
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 64));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'authProvider', 'wishlistIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoUrl', 'phone', 'address', 'authProvider', 'wishlistIds', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.email == request.auth.token.email
        && isValidOptionalString(data, 'photoUrl', 500)
        && isValidOptionalString(data, 'phone', 40)
        && isValidOptionalString(data, 'address', 300)
        && data.authProvider in ['google', 'password']
        && isValidWishlistArray(data.wishlistIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isEmailVerified() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'phone', 'address', 'wishlistIds', 'authProvider', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['wishlistIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt'])
        );
      allow delete: if false;
    }
  }
}
